{
  /*
   * Root TypeScript project covering the repo-root config files and the
   * Playwright end-to-end specs. The Svelte frontend has its own config
   * (frontend/jsconfig.json) and is intentionally not included here.
   *
   * Without this file the editor's TypeScript server places these files in an
   * inferred project that does not apply the root @types/node package, causing
   * "Cannot find name 'process'" in playwright.config.ts.
   */
  "compilerOptions": {
    /* Node globals (e.g. `process.env.CI`) used by the Playwright and Vitest
       configs are provided by @types/node (a root devDependency). */
    "types": ["node"],
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "playwright.config.ts",
    "vitest.config.mts",
    "vitest.setup.ts",
    "tests/e2e/**/*.ts"
  ]
}
